<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.name'|trans({}, 'app') }}{% endblock %}</title>
    
    {# Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block navbar %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('home') }}">
                    <i class="bi bi-bank2"></i> {{ 'app.name'|trans({}, 'app') }}
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        {% if app.user %}
                            {% if is_granted('ROLE_EMPLOYEE') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('employee_dashboard') }}">
                                        <i class="bi bi-speedometer2"></i> {{ 'nav.dashboard'|trans({}, 'app') }}
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('bank_account_open_new_customer') }}">
                                        <i class="bi bi-person-plus"></i> {{ 'nav.new_account'|trans({}, 'app') }}
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted('ROLE_CUSTOMER') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('customer_dashboard') }}">
                                        <i class="bi bi-speedometer2"></i> {{ 'nav.dashboard'|trans({}, 'app') }}
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('transaction_transfer') }}">
                                        <i class="bi bi-arrow-left-right"></i> {{ 'nav.transfer'|trans({}, 'app') }}
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('transaction_history') }}">
                                        <i class="bi bi-clock-history"></i> {{ 'nav.history'|trans({}, 'app') }}
                                    </a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-link nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                        {{ locale_flag(app.request.locale) }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% for locale in available_locales() %}
                                            <li><a class="dropdown-item" href="{{ path('change_locale', {locale: locale.value}) }}">{{ locale_flag(locale.value) }} {{ locale_name(locale.value) }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('logout') }}">
                                    <i class="bi bi-box-arrow-right"></i> {{ 'nav.logout'|trans({}, 'app') }}
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('login') }}">
                                    <i class="bi bi-box-arrow-in-right"></i> {{ 'nav.login'|trans({}, 'app') }}
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    {% endblock %}

    <main>
        <div class="container mt-4">
            {% block flash_messages %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="mt-5 py-3 bg-light text-center">
        <div class="container">
            <p class="text-muted mb-0">{{ 'app.copyright'|trans({}, 'app') }}</p>
        </div>
    </footer>

    {# Bootstrap 5 JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
