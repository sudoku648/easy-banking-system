{#
    Reusable dashboard action card
    
    Parameters:
    - icon: Bootstrap icon class (e.g., 'arrow-left-right')
    - iconColor: Bootstrap color for icon (primary, success, danger, warning, info)
    - title: Card title (translated string)
    - description: Card description (translated string)
    - buttonText: Button text (translated string)
    - buttonColor: Bootstrap color for button
    - route: Route name for the action
    - routeParams: Optional route parameters (default: {})
#}
<div class="card h-100 shadow-sm">
    <div class="card-body text-center">
        <i class="bi bi-{{ icon }} display-4 text-{{ iconColor }} mb-3"></i>
        <h5 class="card-title">{{ title }}</h5>
        <p class="card-text">{{ description }}</p>
        <a href="{{ path(route, routeParams|default({})) }}" class="btn btn-{{ buttonColor }}">
            <i class="bi bi-{{ icon }}"></i> {{ buttonText }}
        </a>
    </div>
</div>
#}
