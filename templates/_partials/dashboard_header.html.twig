{#
    Reusable dashboard header
    
    Parameters:
    - title: Dashboard title (translated string)
    - userName: User's full name
#}
<div class="row">
    <div class="col-12">
        <h1 class="mb-4">
            <i class="bi bi-speedometer2"></i> {{ title }}
        </h1>
        <p class="lead">{{ 'dashboard.welcome_message'|trans({'%name%': userName}, 'dashboard') }}</p>
    </div>
</div>
