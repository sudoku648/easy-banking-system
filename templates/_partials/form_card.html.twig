{#
    Reusable form card template for employee operations

    Parameters:
    - title: Card title (translated string)
    - icon: Bootstrap icon class (e.g., 'person-plus')
    - color: Bootstrap color (primary, success, danger, warning)
    - description: Optional description text (translated string)
    - cancelRoute: Route name for cancel button
    - submitText: Submit button text (translated string)
    - submitIcon: Submit button icon class
    - form: Symfony form object
    - alert: Optional alert block (use {% block alert %})
#}
<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm">
            <div class="card-header bg-{{ color|default('primary') }} text-white">
                <h2 class="mb-0">
                    <i class="bi bi-{{ icon }}"></i> {{ title }}
                </h2>
            </div>
            <div class="card-body">
                {% if description is defined %}
                    <p class="text-muted">{{ description }}</p>
                {% endif %}

                {% block alert %}{% endblock %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                {% block form_fields %}{% endblock %}

                <div class="d-flex justify-content-between">
                    <a href="{{ path(cancelRoute) }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> {{ 'common.cancel'|trans({}, 'app') }}
                    </a>
                    <button type="submit" class="btn btn-{{ color|default('primary') }}">
                        <i class="bi bi-{{ submitIcon|default('check-circle') }}"></i> {{ submitText }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
