{% extends 'base.html.twig' %}

{% block title %}{{ 'transaction.deposit'|trans({}, 'transaction') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'transaction.deposit'|trans({}, 'transaction'),
    icon: 'cash-coin',
    color: 'warning',
    cancelRoute: 'employee_dashboard',
    submitText: 'transaction.deposit'|trans({}, 'transaction'),
    form: form
} %}
    {% block alert %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> {{ 'transaction.cash_deposit'|trans({}, 'transaction') }}
        </div>
    {% endblock %}

    {% block form_fields %}
        <div class="mb-3">
            {{ form_row(form.bankAccountId, {
                label: 'bank_account.iban'|trans({}, 'bank_account')
            }) }}
        </div>

        <div class="mb-3">
            {{ form_row(form.amount, {
                label: 'transaction.amount'|trans({}, 'transaction')
            }) }}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
