{% extends 'base.html.twig' %}

{% block title %}{{ 'transaction.deposit'|trans({}, 'transaction') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'transaction.deposit'|trans({}, 'transaction'),
    icon: 'cash-coin',
    color: 'warning',
    cancelRoute: 'employee_dashboard',
    submitText: 'transaction.deposit'|trans({}, 'transaction'),
    form: form
} %}
    {% block alert %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> {{ 'transaction.cash_deposit'|trans({}, 'transaction') }}
        </div>
    {% endblock %}

    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.bankAccountId) }}
                {{ form_widget(form.bankAccountId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.bankAccountId) }}
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.amount) }}
                {{ form_widget(form.amount, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.amount) }}
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
