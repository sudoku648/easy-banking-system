{% extends 'base.html.twig' %}

{% block title %}{{ 'transaction.customer_history_title'|trans({}, 'transaction') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h2 class="mb-0">
                    <i class="bi bi-clock-history"></i> {{ 'transaction.customer_history_title'|trans({}, 'transaction') }}
                </h2>
                {% if accountIban %}
                    <p class="mb-0 mt-2">
                        <small>{{ 'bank_account.iban'|trans({}, 'bank_account') }}: <code>{{ accountIban }}</code></small>
                    </p>
                {% elseif customerName %}
                    <p class="mb-0 mt-2">
                        <small>{{ customerName }}</small>
                    </p>
                {% endif %}
            </div>
            <div class="card-body">
                {% if transactions|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>{{ 'transaction.date'|trans({}, 'transaction') }}</th>
                                    <th>{{ 'bank_account.iban'|trans({}, 'bank_account') }}</th>
                                    <th>{{ 'transaction.type'|trans({}, 'transaction') }}</th>
                                    <th>{{ 'transaction.status'|trans({}, 'transaction') }}</th>
                                    <th class="text-end">{{ 'transaction.amount'|trans({}, 'transaction') }}</th>
                                    <th class="text-end">{{ 'transaction.original_amount'|trans({}, 'transaction') }}</th>
                                    <th class="text-center">{{ 'transaction.exchange_rate'|trans({}, 'transaction') }}</th>
                                    <th class="text-center">{{ 'transaction.actions'|trans({}, 'transaction') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for transaction in transactions %}
                                    <tr>
                                        <td>
                                            <small>{{ transaction.occurredAt }}</small>
                                        </td>
                                        <td>
                                            <code>{{ transaction.accountIban }}</code>
                                        </td>
                                        <td>
                                            {% if transaction.type == 'TRANSFER_DEPOSIT' %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-arrow-down-circle"></i> {{ 'transaction.transfer_deposit'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'TRANSFER_WITHDRAWAL' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-arrow-up-circle"></i> {{ 'transaction.transfer_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'CASH_WITHDRAWAL' %}
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-cash"></i> {{ 'transaction.cash_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'ATM_WITHDRAWAL' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-credit-card"></i> {{ 'transaction.atm_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'CASH_DEPOSIT' %}
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-cash-coin"></i> {{ 'transaction.cash_deposit'|trans({}, 'transaction') }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if transaction.status == 'ORDERED' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-clock"></i> {{ 'transaction.status_ordered'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.status == 'EXECUTED' %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> {{ 'transaction.status_executed'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.status == 'CANCELED' %}
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle"></i> {{ 'transaction.status_canceled'|trans({}, 'transaction') }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if transaction.type == 'TRANSFER_DEPOSIT' or transaction.type == 'CASH_DEPOSIT' %}
                                                <span class="text-success">
                                                    +{{ transaction.amount|number_format(2, '.', ',') }}
                                                </span>
                                            {% elseif transaction.type == 'TRANSFER_WITHDRAWAL' or transaction.type == 'CASH_WITHDRAWAL' or transaction.type == 'ATM_WITHDRAWAL' %}
                                                <span class="text-danger">
                                                    -{{ transaction.amount|number_format(2, '.', ',') }}
                                                </span>
                                            {% endif %}
                                            <span class="badge bg-secondary">{{ transaction.currency }}</span>
                                        </td>
                                        <td class="text-end">
                                            {{ transaction.originalAmount|number_format(2, '.', ',') }}
                                            <span class="badge bg-secondary">{{ transaction.originalCurrency }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if transaction.exchangeRate != 1.0 %}
                                                <span class="badge bg-info">{{ transaction.exchangeRate|number_format(4) }}</span>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            {% if transaction.status == 'ORDERED' %}
                                                <form method="post" action="{{ path('employee_transaction_cancel') }}" style="display: inline;" onsubmit="return confirm('{{ 'transaction.confirm_cancel'|trans({}, 'transaction') }}')">
                                                    <input type="hidden" name="transactionId" value="{{ transaction.id }}">
                                                    {% if app.request.query.get('customerId') %}
                                                        <input type="hidden" name="customerId" value="{{ app.request.query.get('customerId') }}">
                                                    {% endif %}
                                                    {% if app.request.query.get('bankAccountId') %}
                                                        <input type="hidden" name="bankAccountId" value="{{ app.request.query.get('bankAccountId') }}">
                                                    {% endif %}
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-circle"></i> {{ 'transaction.cancel_transfer'|trans({}, 'transaction') }}
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        {{ 'transaction.no_transactions'|trans({}, 'transaction') }}
                    </div>
                {% endif %}

                <div class="mt-3">
                    <a href="{{ path('employee_transaction_history_select') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> {{ 'common.back'|trans({}, 'app') }}
                    </a>
                    <a href="{{ path('employee_dashboard') }}" class="btn btn-secondary">
                        <i class="bi bi-speedometer2"></i> {{ 'dashboard.go_to_dashboard'|trans({}, 'dashboard') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
