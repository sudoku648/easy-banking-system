{% extends 'base.html.twig' %}

{% block title %}{{ 'transaction.history_title'|trans({}, 'transaction') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h2 class="mb-0">
                    <i class="bi bi-clock-history"></i> {{ 'transaction.history_title'|trans({}, 'transaction') }}
                </h2>
            </div>
            <div class="card-body">
                <div id="transaction-history-root"></div>
                
                <noscript>
                    {% if transactions|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>{{ 'transaction.date'|trans({}, 'transaction') }}</th>
                                    <th>{{ 'bank_account.iban'|trans({}, 'bank_account') }}</th>
                                    <th>{{ 'transaction.type'|trans({}, 'transaction') }}</th>
                                    <th>{{ 'transaction.status'|trans({}, 'transaction') }}</th>
                                    <th class="text-end">{{ 'transaction.amount'|trans({}, 'transaction') }}</th>
                                    <th class="text-end">{{ 'transaction.original_amount'|trans({}, 'transaction') }}</th>
                                    <th class="text-center">{{ 'transaction.exchange_rate'|trans({}, 'transaction') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for transaction in transactions %}
                                    <tr>
                                        <td>
                                            <small>{{ transaction.occurredAt }}</small>
                                        </td>
                                        <td>
                                            <code>{{ transaction.accountIban }}</code>
                                        </td>
                                        <td>
                                            {% if transaction.type == 'TRANSFER_DEPOSIT' %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-arrow-down-circle"></i> {{ 'transaction.transfer_deposit'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'TRANSFER_WITHDRAWAL' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-arrow-up-circle"></i> {{ 'transaction.transfer_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'CASH_WITHDRAWAL' %}
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-cash"></i> {{ 'transaction.cash_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'ATM_WITHDRAWAL' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-credit-card"></i> {{ 'transaction.atm_withdrawal'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.type == 'CASH_DEPOSIT' %}
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-cash-coin"></i> {{ 'transaction.cash_deposit'|trans({}, 'transaction') }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if transaction.status == 'ORDERED' %}
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-clock"></i> {{ 'transaction.status_ordered'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.status == 'EXECUTED' %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> {{ 'transaction.status_executed'|trans({}, 'transaction') }}
                                                </span>
                                            {% elseif transaction.status == 'CANCELED' %}
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle"></i> {{ 'transaction.status_canceled'|trans({}, 'transaction') }}
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if transaction.type == 'TRANSFER_DEPOSIT' or transaction.type == 'CASH_DEPOSIT' %}
                                                <span class="text-success">
                                                    +{{ transaction.amount|number_format(2, '.', ',') }}
                                                </span>
                                            {% elseif transaction.type == 'TRANSFER_WITHDRAWAL' or transaction.type == 'CASH_WITHDRAWAL' or transaction.type == 'ATM_WITHDRAWAL' %}
                                                <span class="text-danger">
                                                    -{{ transaction.amount|number_format(2, '.', ',') }}
                                                </span>
                                            {% endif %}
                                            <span class="badge bg-secondary">{{ transaction.currency }}</span>
                                        </td>
                                        <td class="text-end">
                                            {{ transaction.originalAmount|number_format(2, '.', ',') }}
                                            <span class="badge bg-secondary">{{ transaction.originalCurrency }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if transaction.exchangeRate != 1.0 %}
                                                <span class="badge bg-info">{{ transaction.exchangeRate|number_format(4) }}</span>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            {{ 'transaction.no_transactions'|trans({}, 'transaction') }}
                        </div>
                    {% endif %}
                </noscript>

                <div class="mt-3">
                    <a href="{{ path('customer_dashboard') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> {{ 'common.back'|trans({}, 'app') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="{{ asset('js/transaction-history.js') }}"></script>
    <script>
        const translations = {
            date: '{{ 'transaction.date'|trans({}, 'transaction')|e('js') }}',
            iban: '{{ 'bank_account.iban'|trans({}, 'bank_account')|e('js') }}',
            type: '{{ 'transaction.type'|trans({}, 'transaction')|e('js') }}',
            status: '{{ 'transaction.status'|trans({}, 'transaction')|e('js') }}',
            amount: '{{ 'transaction.amount'|trans({}, 'transaction')|e('js') }}',
            original_amount: '{{ 'transaction.original_amount'|trans({}, 'transaction')|e('js') }}',
            exchange_rate: '{{ 'transaction.exchange_rate'|trans({}, 'transaction')|e('js') }}',
            actions: '{{ 'transaction.actions'|trans({}, 'transaction')|e('js') }}',
            transfer_deposit: '{{ 'transaction.transfer_deposit'|trans({}, 'transaction')|e('js') }}',
            transfer_withdrawal: '{{ 'transaction.transfer_withdrawal'|trans({}, 'transaction')|e('js') }}',
            cash_withdrawal: '{{ 'transaction.cash_withdrawal'|trans({}, 'transaction')|e('js') }}',
            cash_deposit: '{{ 'transaction.cash_deposit'|trans({}, 'transaction')|e('js') }}',
            atm_withdrawal: '{{ 'transaction.atm_withdrawal'|trans({}, 'transaction')|e('js') }}',
            status_ordered: '{{ 'transaction.status_ordered'|trans({}, 'transaction')|e('js') }}',
            status_executed: '{{ 'transaction.status_executed'|trans({}, 'transaction')|e('js') }}',
            status_canceled: '{{ 'transaction.status_canceled'|trans({}, 'transaction')|e('js') }}',
            cancel_transfer: '{{ 'transaction.cancel_transfer'|trans({}, 'transaction')|e('js') }}',
            confirm_cancel: '{{ 'transaction.confirm_cancel'|trans({}, 'transaction')|e('js') }}',
            rows_per_page: '{{ 'transaction.rows_per_page'|trans({}, 'transaction')|e('js') }}',
            showing_records: '{{ 'transaction.showing_records'|trans({}, 'transaction')|e('js') }}',
            page: '{{ 'transaction.page'|trans({}, 'transaction')|e('js') }}',
            previous: '{{ 'transaction.previous'|trans({}, 'transaction')|e('js') }}',
            next: '{{ 'transaction.next'|trans({}, 'transaction')|e('js') }}',
            loading: '{{ 'transaction.loading'|trans({}, 'transaction')|e('js') }}',
            no_data: '{{ 'transaction.no_data'|trans({}, 'transaction')|e('js') }}'
        };

        const root = ReactDOM.createRoot(document.getElementById('transaction-history-root'));
        root.render(
            React.createElement(TransactionHistory, {
                apiUrl: '{{ path('api_customer_transaction_history') }}',
                translations: translations,
                showCancelButton: false
            })
        );
    </script>
{% endblock %}
