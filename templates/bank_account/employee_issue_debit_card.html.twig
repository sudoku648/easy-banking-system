{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.issue_debit_card'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'bank_account.issue_debit_card'|trans({}, 'bank_account'),
    icon: 'credit-card',
    color: 'primary',
    description: 'bank_account.issue_debit_card_description'|trans({}, 'bank_account'),
    cancelRoute: 'employee_dashboard',
    submitText: 'bank_account.issue_card'|trans({}, 'bank_account'),
    submitIcon: 'check-circle',
    form: form
} %}
    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.bankAccountId) }}
                {{ form_widget(form.bankAccountId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.bankAccountId) }}
                <small class="form-text text-muted">{{ 'bank_account.help_select_account_for_card'|trans({}, 'bank_account') }}</small>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
