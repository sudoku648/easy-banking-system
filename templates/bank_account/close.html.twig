{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.close'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'bank_account.close'|trans({}, 'bank_account'),
    icon: 'x-circle',
    color: 'danger',
    cancelRoute: 'employee_dashboard',
    submitText: 'bank_account.close'|trans({}, 'bank_account'),
    submitIcon: 'x-circle',
    form: form
} %}
    {% block alert %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>{{ 'flash.warning'|trans({}, 'flash') }}:</strong> {{ 'bank_account.confirm_close'|trans({}, 'bank_account') }}
        </div>
    {% endblock %}

    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.bankAccountId) }}
                {{ form_widget(form.bankAccountId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.bankAccountId) }}
                <small class="form-text text-muted">Select the bank account to close. The IBAN and current balance are shown.</small>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
