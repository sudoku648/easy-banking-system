{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.close'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h2 class="mb-0">
                    <i class="bi bi-x-circle"></i> {{ 'bank_account.close'|trans({}, 'bank_account') }}
                </h2>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>{{ 'flash.warning'|trans({}, 'flash') }}:</strong> {{ 'bank_account.confirm_close'|trans({}, 'bank_account') }}
                </div>

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                
                <div class="mb-3">
                    <div class="form-group">
                        {{ form_label(form.bankAccountId) }}
                        {{ form_widget(form.bankAccountId, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.bankAccountId) }}
                        <small class="form-text text-muted">Select the bank account to close. The IBAN and current balance are shown.</small>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('employee_dashboard') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> {{ 'common.cancel'|trans({}, 'app') }}
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> {{ 'bank_account.close'|trans({}, 'bank_account') }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
