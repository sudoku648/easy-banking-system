{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.open_for_existing_customer'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'bank_account.open_for_existing_customer'|trans({}, 'bank_account'),
    icon: 'person-check',
    color: 'success',
    description: 'bank_account.open_for_existing_customer'|trans({}, 'bank_account'),
    cancelRoute: 'employee_dashboard',
    submitText: 'bank_account.open_new'|trans({}, 'bank_account'),
    submitIcon: 'check-circle',
    form: form
} %}
    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.customerId) }}
                {{ form_widget(form.customerId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.customerId) }}
                <small class="form-text text-muted">Select the customer who wants to open a new account</small>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.currency) }}
                {{ form_widget(form.currency, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.currency) }}
                <small class="form-text text-muted">Select the currency for the new bank account</small>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
