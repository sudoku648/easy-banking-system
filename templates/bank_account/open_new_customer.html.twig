{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.open_for_new_customer'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'bank_account.open_for_new_customer'|trans({}, 'bank_account'),
    icon: 'person-plus',
    color: 'primary',
    description: 'bank_account.open_for_new_customer'|trans({}, 'bank_account'),
    cancelRoute: 'employee_dashboard',
    submitText: 'bank_account.open_new'|trans({}, 'bank_account'),
    submitIcon: 'check-circle',
    form: form
} %}
    {% block form_fields %}
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.firstName) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.lastName) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.username) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.username) }}
                    <small class="form-text text-muted">{{ 'bank_account.help_username'|trans({}, 'bank_account') }}</small>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.password) }}
                    <small class="form-text text-muted">{{ 'bank_account.help_password'|trans({}, 'bank_account') }}</small>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.currency) }}
                {{ form_widget(form.currency, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.currency) }}
                <small class="form-text text-muted">{{ 'bank_account.help_select_currency_new'|trans({}, 'bank_account') }}</small>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
