{% extends 'base.html.twig' %}

{% block title %}{{ 'user.change_password'|trans({}, 'app') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'user.change_password'|trans({}, 'app'),
    icon: 'key',
    color: color|default('warning'),
    description: 'user.change_password_description'|trans({}, 'app'),
    cancelRoute: cancelRoute,
    submitText: 'user.change_password_submit'|trans({}, 'app'),
    submitIcon: 'check-circle',
    form: form
} %}
    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.currentPassword) }}
                {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control', 'autocomplete': 'current-password'}}) }}
                {{ form_errors(form.currentPassword) }}
                <small class="form-text text-muted">{{ 'user.help_current_password'|trans({}, 'app') }}</small>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.newPassword) }}
                {{ form_widget(form.newPassword, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                {{ form_errors(form.newPassword) }}
                <small class="form-text text-muted">{{ 'user.help_new_password'|trans({}, 'app') }}</small>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.confirmNewPassword) }}
                {{ form_widget(form.confirmNewPassword, {'attr': {'class': 'form-control', 'autocomplete': 'new-password'}}) }}
                {{ form_errors(form.confirmNewPassword) }}
                <small class="form-text text-muted">{{ 'user.help_confirm_new_password'|trans({}, 'app') }}</small>
            </div>
        </div>

        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            {{ 'user.password_security_note'|trans({}, 'app') }}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
