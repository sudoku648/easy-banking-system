{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.customer_title'|trans({}, 'dashboard') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% include '_partials/dashboard_header.html.twig' with {
    title: 'dashboard.customer_title'|trans({}, 'dashboard'),
    userName: app.user.user.fullName
} %}

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">
                    <i class="bi bi-wallet2"></i> {{ 'dashboard.your_accounts'|trans({}, 'dashboard') }}
                </h3>
            </div>
            <div class="card-body">
                {% if accounts|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>{{ 'bank_account.iban'|trans({}, 'bank_account') }}</th>
                                    <th class="text-end">{{ 'bank_account.balance'|trans({}, 'bank_account') }}</th>
                                    <th>{{ 'bank_account.currency'|trans({}, 'bank_account') }}</th>
                                    <th class="text-center">{{ 'common.status'|trans({}, 'app') }}</th>
                                    <th class="text-center">{{ 'common.actions'|trans({}, 'app') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for account in accounts %}
                                    <tr>
                                        <td>
                                            <code>{{ account.iban }}</code>
                                        </td>
                                        <td class="text-end">
                                            <strong>{{ account.balance|number_format(2, '.', ',') }}</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ account.currency }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if account.isActive %}
                                                <span class="badge bg-success">{{ 'common.active'|trans({}, 'app') }}</span>
                                            {% else %}
                                                <span class="badge bg-danger">{{ 'common.closed'|trans({}, 'app') }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            {% if account.isActive %}
                                                <a href="{{ path('transaction_transfer', {fromAccountId: account.id}) }}" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="bi bi-arrow-left-right"></i> {{ 'transaction.transfer'|trans({}, 'transaction') }}
                                                </a>
                                            {% else %}
                                                <button class="btn btn-sm btn-secondary" disabled>
                                                    {{ 'common.account_closed'|trans({}, 'app') }}
                                                </button>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        {{ 'dashboard.no_accounts'|trans({}, 'dashboard') }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'arrow-left-right',
            iconColor: 'primary',
            title: 'dashboard.make_transfer'|trans({}, 'dashboard'),
            description: 'dashboard.make_transfer_desc'|trans({}, 'dashboard'),
            buttonText: 'dashboard.transfer_money'|trans({}, 'dashboard'),
            buttonColor: 'primary',
            route: 'transaction_transfer'
        } %}
    </div>

    <div class="col-md-6 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'clock-history',
            iconColor: 'info',
            title: 'dashboard.transaction_history'|trans({}, 'dashboard'),
            description: 'dashboard.transaction_history_desc'|trans({}, 'dashboard'),
            buttonText: 'dashboard.view_history'|trans({}, 'dashboard'),
            buttonColor: 'info',
            route: 'transaction_history'
        } %}
    </div>
</div>
{% endblock %}
