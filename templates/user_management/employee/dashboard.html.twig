{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.employee_title'|trans({}, 'dashboard') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% include '_partials/dashboard_header.html.twig' with {
    title: 'dashboard.employee_title'|trans({}, 'dashboard'),
    userName: app.user.user.fullName
} %}

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'person-plus',
            iconColor: 'primary',
            title: 'bank_account.open_new'|trans({}, 'bank_account'),
            description: 'bank_account.open_for_new_customer'|trans({}, 'bank_account'),
            buttonText: 'bank_account.new_customer_info'|trans({}, 'bank_account'),
            buttonColor: 'primary',
            route: 'bank_account_open_new_customer'
        } %}
    </div>

    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'person-check',
            iconColor: 'success',
            title: 'bank_account.open_for_existing_customer'|trans({}, 'bank_account'),
            description: 'bank_account.open_for_existing_customer'|trans({}, 'bank_account'),
            buttonText: 'bank_account.select_customer'|trans({}, 'bank_account'),
            buttonColor: 'success',
            route: 'bank_account_open_existing_customer'
        } %}
    </div>

    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'x-circle',
            iconColor: 'danger',
            title: 'bank_account.close'|trans({}, 'bank_account'),
            description: 'bank_account.close'|trans({}, 'bank_account'),
            buttonText: 'bank_account.close'|trans({}, 'bank_account'),
            buttonColor: 'danger',
            route: 'bank_account_close'
        } %}
    </div>

    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'cash-coin',
            iconColor: 'warning',
            title: 'transaction.deposit'|trans({}, 'transaction'),
            description: 'transaction.cash_deposit'|trans({}, 'transaction'),
            buttonText: 'transaction.deposit'|trans({}, 'transaction'),
            buttonColor: 'warning',
            route: 'employee_transaction_deposit'
        } %}
    </div>

    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'clock-history',
            iconColor: 'info',
            title: 'transaction.customer_history'|trans({}, 'transaction'),
            description: 'transaction.view_customer_history'|trans({}, 'transaction'),
            buttonText: 'transaction.view_history'|trans({}, 'transaction'),
            buttonColor: 'info',
            route: 'employee_transaction_history_select'
        } %}
    </div>

    <div class="col-md-4 mb-3">
        {% include '_partials/dashboard_card.html.twig' with {
            icon: 'key',
            iconColor: 'secondary',
            title: 'user.change_password'|trans({}, 'app'),
            description: 'user.change_password_description'|trans({}, 'app'),
            buttonText: 'user.change_password'|trans({}, 'app'),
            buttonColor: 'secondary',
            route: 'employee_change_password'
        } %}
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle text-info"></i> {{ 'dashboard.quick_info'|trans({}, 'dashboard') }}
                </h5>
                <ul class="mb-0">
                    <li>{{ 'dashboard.quick_info.currency'|trans({}, 'dashboard') }}</li>
                    <li>{{ 'dashboard.quick_info.iban'|trans({}, 'dashboard') }}</li>
                    <li>{{ 'dashboard.quick_info.close'|trans({}, 'dashboard') }}</li>
                    <li>{{ 'dashboard.quick_info.history'|trans({}, 'dashboard') }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
