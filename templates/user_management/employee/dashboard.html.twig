{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.employee_title'|trans({}, 'dashboard') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <h1 class="mb-4">
            <i class="bi bi-speedometer2"></i> {{ 'dashboard.employee_title'|trans({}, 'dashboard') }}
        </h1>
        <p class="lead">{{ 'dashboard.welcome_message'|trans({'%name%': app.user.user.fullName}, 'dashboard') }}</p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-person-plus display-4 text-primary mb-3"></i>
                <h5 class="card-title">{{ 'bank_account.open_new'|trans({}, 'bank_account') }}</h5>
                <p class="card-text">{{ 'bank_account.open_for_new_customer'|trans({}, 'bank_account') }}</p>
                <a href="{{ path('bank_account_open_new_customer') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> {{ 'bank_account.new_customer_info'|trans({}, 'bank_account') }}
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-person-check display-4 text-success mb-3"></i>
                <h5 class="card-title">{{ 'bank_account.open_for_existing_customer'|trans({}, 'bank_account') }}</h5>
                <p class="card-text">{{ 'bank_account.open_for_existing_customer'|trans({}, 'bank_account') }}</p>
                <a href="{{ path('bank_account_open_existing_customer') }}" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> {{ 'bank_account.select_customer'|trans({}, 'bank_account') }}
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-x-circle display-4 text-danger mb-3"></i>
                <h5 class="card-title">{{ 'bank_account.close'|trans({}, 'bank_account') }}</h5>
                <p class="card-text">{{ 'bank_account.close'|trans({}, 'bank_account') }}</p>
                <a href="{{ path('bank_account_close') }}" class="btn btn-danger">
                    <i class="bi bi-x-circle"></i> {{ 'bank_account.close'|trans({}, 'bank_account') }}
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-cash-coin display-4 text-warning mb-3"></i>
                <h5 class="card-title">{{ 'transaction.deposit'|trans({}, 'transaction') }}</h5>
                <p class="card-text">{{ 'transaction.cash_deposit'|trans({}, 'transaction') }}</p>
                <a href="{{ path('employee_transaction_deposit') }}" class="btn btn-warning">
                    <i class="bi bi-cash-stack"></i> {{ 'transaction.deposit'|trans({}, 'transaction') }}
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle text-info"></i> Quick Info
                </h5>
                <ul class="mb-0">
                    <li>You can create accounts in PLN or EUR currency</li>
                    <li>IBAN numbers are generated automatically</li>
                    <li>When closing an account, all remaining funds are withdrawn</li>
                    <li>View customer transaction history using the account management</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
