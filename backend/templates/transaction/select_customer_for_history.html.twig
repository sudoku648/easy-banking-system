{% extends 'base.html.twig' %}

{% block title %}{{ 'transaction.select_customer_for_history'|trans({}, 'transaction') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/customer-account-selector.js') }}"></script>
{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'transaction.select_customer_for_history'|trans({}, 'transaction'),
    icon: 'clock-history',
    color: 'info',
    cancelRoute: 'employee_dashboard',
    submitText: 'transaction.view_history'|trans({}, 'transaction'),
    form: form
} %}
    {% block alert %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> {{ 'transaction.select_customer_or_account'|trans({}, 'transaction') }}
        </div>
    {% endblock %}

    {% block form_fields %}
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.customerId) }}
                {{ form_widget(form.customerId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.customerId) }}
                {% if form.customerId.vars.help is defined %}
                    <small class="form-text text-muted">{{ form.customerId.vars.help|trans({}, 'transaction') }}</small>
                {% endif %}
            </div>
        </div>

        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.bankAccountId) }}
                {{ form_widget(form.bankAccountId, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.bankAccountId) }}
                {% if form.bankAccountId.vars.help is defined %}
                    <small class="form-text text-muted">{{ form.bankAccountId.vars.help|trans({}, 'transaction') }}</small>
                {% endif %}
            </div>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
