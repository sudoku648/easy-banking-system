{% extends 'base.html.twig' %}

{% block title %}{{ 'bank_account.open_for_new_customer'|trans({}, 'bank_account') }} - {{ 'app.name'|trans({}, 'app') }}{% endblock %}

{% block body %}
{% embed '_partials/form_card.html.twig' with {
    title: 'bank_account.open_for_new_customer'|trans({}, 'bank_account'),
    icon: 'person-plus',
    color: 'primary',
    description: 'bank_account.open_for_new_customer'|trans({}, 'bank_account'),
    cancelRoute: 'employee_dashboard',
    submitText: 'bank_account.open_new'|trans({}, 'bank_account'),
    submitIcon: 'check-circle',
    form: form
} %}
    {% block form_fields %}
        {# Personal Information #}
        <h5 class="mb-3">{{ 'bank_account.personal_info'|trans({}, 'bank_account') }}</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.firstName) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.lastName) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.username) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.username) }}
                    <small class="form-text text-muted">{{ 'bank_account.help_username'|trans({}, 'bank_account') }}</small>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.password) }}
                    <small class="form-text text-muted">{{ 'bank_account.help_password'|trans({}, 'bank_account') }}</small>
                </div>
            </div>
        </div>

        {# Permanent Residence Address #}
        <h5 class="mb-3 mt-4">{{ 'bank_account.permanent_residence'|trans({}, 'bank_account') }}</h5>
        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-group">
                        {{ form_label(form.permanentResidenceStreet) }}
                        {{ form_widget(form.permanentResidenceStreet, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.permanentResidenceStreet) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            {{ form_label(form.permanentResidenceCity) }}
                            {{ form_widget(form.permanentResidenceCity, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.permanentResidenceCity) }}
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label>{{ 'bank_account.permanent_residence_postal_code'|trans({}, 'bank_account') }}</label>
                            <div class="d-flex align-items-center gap-2">
                                {{ form_widget(form.permanentResidencePostalCode1, {'attr': {'class': 'form-control', 'style': 'width: 60px; display: inline-block;'}}) }}
                                <span style="margin: 0 5px;">-</span>
                                {{ form_widget(form.permanentResidencePostalCode2, {'attr': {'class': 'form-control', 'style': 'width: 80px; display: inline-block;'}}) }}
                            </div>
                            {{ form_errors(form.permanentResidencePostalCode1) }}
                            {{ form_errors(form.permanentResidencePostalCode2) }}
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-group">
                        {{ form_label(form.permanentResidenceCountry) }}
                        {{ form_widget(form.permanentResidenceCountry, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.permanentResidenceCountry) }}
                    </div>
                </div>
            </div>
        </div>

        {# Correspondence Address #}
        <h5 class="mb-3 mt-4">{{ 'bank_account.correspondence'|trans({}, 'bank_account') }}</h5>
        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check">
                        {{ form_widget(form.sameAsPermament, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.sameAsPermament, null, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                </div>

                <div id="correspondence-address-group">
                    <div id="correspondence-addresses-container" data-index="{{ form.correspondenceAddresses|length }}">
                        {% for addressForm in form.correspondenceAddresses %}
                            <div class="correspondence-address-item border rounded p-3 mb-3 position-relative" data-address-index="{{ loop.index0 }}">
                                <div class="mb-3">
                                    <div class="form-group">
                                        {{ form_label(addressForm.street) }}
                                        {{ form_widget(addressForm.street, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(addressForm.street) }}
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="form-group">
                                            {{ form_label(addressForm.city) }}
                                            {{ form_widget(addressForm.city, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(addressForm.city) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="form-group">
                                            <label>{{ 'bank_account.correspondence_postal_code'|trans({}, 'bank_account') }}</label>
                                            <div class="d-flex align-items-center gap-2">
                                                {{ form_widget(addressForm.postalCode1, {'attr': {'class': 'form-control', 'style': 'width: 60px; display: inline-block;'}}) }}
                                                <span style="margin: 0 5px;">-</span>
                                                {{ form_widget(addressForm.postalCode2, {'attr': {'class': 'form-control', 'style': 'width: 80px; display: inline-block;'}}) }}
                                            </div>
                                            {{ form_errors(addressForm.postalCode1) }}
                                            {{ form_errors(addressForm.postalCode2) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-group">
                                        {{ form_label(addressForm.country) }}
                                        {{ form_widget(addressForm.country, {'attr': {'class': 'form-select'}}) }}
                                        {{ form_errors(addressForm.country) }}
                                    </div>
                                </div>

                                {% if loop.index > 1 %}
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 remove-address-btn">
                                        <i class="bi bi-trash"></i> {{ 'bank_account.remove_address'|trans({}, 'bank_account') }}
                                    </button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>

                    {# Template prototype stored in container's data-prototype attribute #}
                    {# It will be used by JavaScript to add new addresses dynamically #}

                    <button type="button" id="add-correspondence-address" class="btn btn-secondary btn-sm">
                        <i class="bi bi-plus-circle"></i> {{ 'bank_account.add_correspondence_address'|trans({}, 'bank_account') }}
                    </button>
                </div>
            </div>
        </div>

        {# Account Settings #}
        <h5 class="mb-3 mt-4">{{ 'bank_account.account_settings'|trans({}, 'bank_account') }}</h5>
        <div class="mb-3">
            <div class="form-group">
                {{ form_label(form.currency) }}
                {{ form_widget(form.currency, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.currency) }}
                <small class="form-text text-muted">{{ 'bank_account.help_select_currency_new'|trans({}, 'bank_account') }}</small>
            </div>
        </div>

        <script>
            (function() {
                'use strict';
                
                document.addEventListener('DOMContentLoaded', function() {
                    // Use the auto-generated Symfony form field ID
                    const checkbox = document.getElementById('open_account_new_customer_form_sameAsPermament');
                    const correspondenceGroup = document.getElementById('correspondence-address-group');
                    const addressesContainer = document.getElementById('correspondence-addresses-container');
                    const addButton = document.getElementById('add-correspondence-address');

                    console.log('All elements found, setting up event listeners');

                    function toggleCorrespondenceAddress() {
                        if (checkbox.checked) {
                            correspondenceGroup.style.display = 'none';
                            // Disable all fields in correspondence addresses when hidden
                            const inputs = correspondenceGroup.querySelectorAll('input, select');
                            inputs.forEach(input => input.disabled = true);
                        } else {
                            correspondenceGroup.style.display = 'block';
                            // Re-enable all fields
                            const inputs = correspondenceGroup.querySelectorAll('input, select');
                            inputs.forEach(input => input.disabled = false);
                        }
                    }

                    checkbox.addEventListener('change', toggleCorrespondenceAddress);
                    // Set initial state
                    toggleCorrespondenceAddress();

                // Add new correspondence address
                addButton.addEventListener('click', function() {
                    const index = parseInt(addressesContainer.dataset.index);

                    // Get the first existing address item as template
                    const existingAddresses = addressesContainer.querySelectorAll('.correspondence-address-item');
                    if (existingAddresses.length === 0) return;

                    const template = existingAddresses[0];
                    const newAddress = template.cloneNode(true);

                    // Update the data-address-index
                    newAddress.dataset.addressIndex = index;

                    // Replace the index in all form field names and IDs (from [0] to [index])
                    const currentIndex = template.dataset.addressIndex || '0';
                    newAddress.innerHTML = newAddress.innerHTML.replace(
                        new RegExp(`\\[${currentIndex}\\]`, 'g'),
                        `[${index}]`
                    );
                    newAddress.innerHTML = newAddress.innerHTML.replace(
                        new RegExp(`_${currentIndex}_`, 'g'),
                        `_${index}_`
                    );

                    // Clear values in the cloned fields
                    newAddress.querySelectorAll('input, select, textarea').forEach(field => {
                        if (field.type === 'checkbox' || field.type === 'radio') {
                            field.checked = false;
                        } else {
                            field.value = '';
                        }
                    });

                    // Ensure the remove button is visible
                    const removeBtn = newAddress.querySelector('.remove-address-btn');
                    if (removeBtn) {
                        removeBtn.style.display = 'block';
                    }

                    addressesContainer.appendChild(newAddress);
                    addressesContainer.dataset.index = index + 1;
                });

                    // Remove correspondence address
                    document.addEventListener('click', function(e) {
                        if (e.target.closest('.remove-address-btn')) {
                            e.target.closest('.correspondence-address-item').remove();
                        }
                    });
                    
                    console.log('Correspondence address form initialized successfully');
                });
            })();
        </script>
    {% endblock %}
{% endembed %}
{% endblock %}
